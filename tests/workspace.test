#!/usr/bin/env bash

## Create a git repository at $1 containing $2 commits (default 1)
createRepo() {
	mkdir -p "$1"
	git -C "$1" init -q -b main
	git -C "$1" config user.email test@example.com
	git -C "$1" config user.name "Test User"
	i=0
	while [ "$i" -lt "${2:-1}" ]; do
		echo "content $i" >"$1/file$i.txt"
		git -C "$1" add "file$i.txt"
		git -C "$1" commit -q -m "commit $i"
		i=$((i + 1))
	done
}

## Initialize a workspace in a subdirectory and move into it. Tests start in
## the project directory, which is itself a git repository, so the workspace
## can't live there.
newWorkspace() {
	mkdir ws
	cd ws
	workset init
}

## Initializing a workspace creates the library and is idempotent
testInit() {
	mkdir ws
	cd ws

	workset init | grep "^Initialized workspace in "
	[ -d .workset ]

	workset init | grep "^Workspace already initialized in "
	[ -d .workset ]
}

## Commands that need a workspace say so and fail outside one
testCommandsOutsideWorkspaceFail() {
	for command in list status drop; do
		output=$(workset $command 2>&1) && exit 1
		echo "$output" | grep "Not in a workspace"
	done
}

## An unrecognized subcommand fails instead of silently doing nothing
testUnknownCommandFails() {
	newWorkspace

	output=$(workset frobnicate 2>&1) && exit 1
	echo "$output" | grep "Unknown command: frobnicate"
}

## Commands that need a pattern fail when it's missing
testMissingPatternFails() {
	newWorkspace

	output=$(workset clone 2>&1) && exit 1
	echo "$output" | grep "Missing repository pattern"

	output=$(workset restore 2>&1) && exit 1
	echo "$output" | grep "Missing repository pattern"
}

## A clean repo moves to the library and comes back with its files
testDropAndRestore() {
	newWorkspace
	createRepo test-repo 3

	workset drop test-repo | grep -- "test-repo - ✓ dropped"
	[ ! -e test-repo ]
	[ -d .workset/test-repo ]

	workset restore test-repo | grep "^Restored test-repo$"
	[ -d test-repo/.git ]
	[ -f test-repo/file0.txt ]
	[ -f test-repo/file1.txt ]
	[ -f test-repo/file2.txt ]
}

## A repo with uncommitted changes is left where it is, and the drop reports
## why it refused and fails
testDropRefusesDirtyRepo() {
	newWorkspace
	createRepo dirty-repo 2
	echo "uncommitted changes" >dirty-repo/dirty.txt

	output=$(workset drop dirty-repo 2>&1) && exit 1
	echo "$output" | grep -- "dirty-repo - ⚠ kept (uncommitted changes"

	[ -d dirty-repo/.git ]
	[ ! -e .workset/dirty-repo ]
}

## A repo with no commits yet still holds whatever is in its worktree, and
## that work exists nowhere else, so the drop refuses it too
testDropRefusesCommitlessRepoWithWork() {
	newWorkspace
	createRepo fresh-repo 0
	echo "unfinished work" >fresh-repo/notes.txt
	git -C fresh-repo add notes.txt
	echo "scratch" >fresh-repo/untracked.txt

	output=$(workset drop fresh-repo 2>&1) && exit 1
	echo "$output" | grep -- "fresh-repo - ⚠ kept (uncommitted changes"

	[ -f fresh-repo/notes.txt ]
	[ -f fresh-repo/untracked.txt ]
	[ ! -e .workset/fresh-repo ]

	workset list | grep -- "fresh-repo - ⚠ modified"
}

## A repo with no commits and nothing in its worktree has no work to lose
testDropCommitlessEmptyRepo() {
	newWorkspace
	createRepo empty-repo 0

	workset drop empty-repo | grep -- "empty-repo - ✓ dropped"
	[ ! -e empty-repo ]
	[ -d .workset/empty-repo ]
}

## A repo holding commits that aren't on any remote is left where it is
testDropRefusesUnpushedRepo() {
	newWorkspace
	# The bare remote lives outside the workspace so workset doesn't treat it
	# as a repo of its own
	git init -q --bare "$PWD/../remote.git"
	createRepo unpushed-repo 1
	git -C unpushed-repo remote add origin "$PWD/../remote.git"
	git -C unpushed-repo push -q -u origin main
	echo "local" >unpushed-repo/local.txt
	git -C unpushed-repo add local.txt
	git -C unpushed-repo commit -q -m "local only"

	output=$(workset drop unpushed-repo 2>&1) && exit 1
	echo "$output" | grep -- "unpushed-repo - ⚠ kept (unpushed commits"

	[ -d unpushed-repo/.git ]
	[ ! -e .workset/unpushed-repo ]
}

## Every pattern on the command line is dropped, not just the first
testDropSeveralPatterns() {
	newWorkspace
	createRepo repo1
	createRepo repo2
	createRepo repo3

	output=$(workset drop repo1 repo3)
	echo "$output" | grep -- "repo1 - ✓ dropped"
	echo "$output" | grep -- "repo3 - ✓ dropped"

	[ ! -e repo1 ]
	[ ! -e repo3 ]
	[ -d repo2/.git ]
}

## Several patterns can be restored in one request too
testRestoreSeveralPatterns() {
	newWorkspace
	createRepo repo1
	createRepo repo2
	workset drop repo1 repo2

	workset restore repo1 repo2

	[ -f repo1/file0.txt ]
	[ -f repo2/file0.txt ]
}

## Among several patterns, the one that matches nothing is named and fails the
## request, while the others are still dropped
testDropNamesEachUnmatchedPattern() {
	newWorkspace
	createRepo repo1

	output=$(workset drop repo1 no-such-repo 2>&1) && exit 1
	echo "$output" | grep -- "repo1 - ✓ dropped"
	echo "$output" | grep "No repository in the workspace matches 'no-such-repo'"

	[ ! -e repo1 ]
}

## A pattern left in place by its outstanding changes fails the request even
## when another pattern was dropped
testDropSeveralPatternsReportsPartialSuccess() {
	newWorkspace
	createRepo clean-repo
	createRepo dirty-repo
	echo "uncommitted changes" >dirty-repo/dirty.txt

	output=$(workset drop clean-repo dirty-repo 2>&1) && exit 1
	echo "$output" | grep -- "clean-repo - ✓ dropped"
	echo "$output" | grep -- "dirty-repo - ⚠ kept (uncommitted changes"

	[ ! -e clean-repo ]
	[ -d dirty-repo/.git ]
}

## A mistyped flag is reported as the unrecognized argument it is, instead of
## being taken for a repo pattern (which, for --force, would have dropped a
## repo nobody asked about)
testDropRejectsMistypedFlag() {
	newWorkspace
	createRepo repo1

	for flag in --delet --forc; do
		output=$(workset drop $flag repo1 2>&1) && exit 1
		echo "$output" | grep "Unrecognized argument: $flag"

		[ -d repo1/.git ]
		[ ! -e .workset/repo1 ]
	done
}

## Clone and restore reject a mistyped flag the same way
testCloneAndRestoreRejectMistypedFlag() {
	newWorkspace

	output=$(workset clone --oops github.com/user/repo 2>&1) && exit 1
	echo "$output" | grep "Unrecognized argument: --oops"
	[ ! -e github.com ]

	output=$(workset restore --oops anything 2>&1) && exit 1
	echo "$output" | grep "Unrecognized argument: --oops"
}

## The commands that take no pattern say so instead of ignoring one
testArgumentlessCommandsRejectExtraArguments() {
	newWorkspace
	createRepo repo1

	for command in init list ls status; do
		output=$(workset $command extra 2>&1) && exit 1
		echo "$output" | grep "Unrecognized argument: extra"
	done

	output=$(workset status --oops 2>&1) && exit 1
	echo "$output" | grep "Unrecognized argument: --oops"
}

## A pattern that matches nothing is reported as a failure
testDropUnmatchedPatternFails() {
	newWorkspace
	createRepo other-repo 1

	output=$(workset drop no-such-repo 2>&1) && exit 1
	echo "$output" | grep "No repository in the workspace matches 'no-such-repo'"

	[ -d other-repo/.git ]
}

## Dropping everything in a directory with no repos is reported as a failure
testDropAllWithoutReposFails() {
	newWorkspace
	mkdir empty
	cd empty

	output=$(workset drop 2>&1) && exit 1
	echo "$output" | grep "No repositories found in the current directory"
}

## A drop that leaves some repos behind reports both halves and still fails
testDropAllReportsPartialSuccess() {
	newWorkspace
	createRepo clean-repo 1
	createRepo dirty-repo 1
	echo "uncommitted changes" >dirty-repo/dirty.txt

	output=$(workset drop 2>&1) && exit 1
	echo "$output" | grep -- "clean-repo - ✓ dropped"
	echo "$output" | grep -- "dirty-repo - ⚠ kept (uncommitted changes"

	[ ! -e clean-repo ]
	[ -d dirty-repo/.git ]
}

## Restoring something that isn't in the library is reported as a failure
testRestoreUnmatchedPatternFails() {
	newWorkspace
	createRepo stored-repo 1
	workset drop stored-repo

	output=$(workset restore no-such-repo 2>&1) && exit 1
	echo "$output" | grep "No repository in the library matches 'no-such-repo'"
}

## Restoring from an empty library is reported as a failure
testRestoreFromEmptyLibraryFails() {
	newWorkspace

	output=$(workset restore anything 2>&1) && exit 1
	echo "$output" | grep "The library is empty"
}

## Restoring a repo that is already checked out is reported as a failure
testRestoreAlreadyInWorkspaceFails() {
	newWorkspace
	createRepo present-repo 1
	workset drop present-repo
	workset restore present-repo

	output=$(workset restore present-repo 2>&1) && exit 1
	echo "$output" | grep "present-repo is already in the workspace"

	[ -d present-repo/.git ]
}

## --force drops a repo despite its uncommitted changes
testDropDirtyRepoWithForce() {
	newWorkspace
	createRepo dirty-repo 2
	echo "uncommitted changes" >dirty-repo/dirty.txt

	workset drop --force dirty-repo

	[ ! -e dirty-repo ]
	[ -d .workset/dirty-repo ]
}

## --delete removes a repo instead of storing it in the library
testDropWithDelete() {
	newWorkspace
	createRepo delete-me 1

	workset drop --delete delete-me

	[ ! -e delete-me ]
	[ ! -e .workset/delete-me ]
}

## Without a pattern, every repo in the current directory is dropped
testDropAll() {
	newWorkspace
	createRepo repo1
	createRepo repo2
	createRepo repo3

	workset drop

	[ ! -e repo1 ]
	[ ! -e repo2 ]
	[ ! -e repo3 ]
	[ -d .workset/repo1 ]
	[ -d .workset/repo2 ]
	[ -d .workset/repo3 ]
}

## Dropping everything only reaches repos under the current directory
testDropAllFromSubdirectory() {
	newWorkspace
	createRepo projects/repo1
	createRepo projects/repo2
	createRepo root-repo

	cd projects
	workset drop

	[ ! -e repo1 ]
	[ ! -e repo2 ]
	[ -d ../root-repo ]
	[ -d ../.workset/projects/repo1 ]
	[ -d ../.workset/projects/repo2 ]
}

## Repos nested under a provider path keep their path in the library
testDropAndRestoreNestedRepo() {
	newWorkspace
	createRepo github.com/testuser/nested-repo 2

	workset drop github.com/testuser/nested-repo
	[ ! -e github.com/testuser/nested-repo ]
	[ -d .workset/github.com/testuser/nested-repo ]

	workset restore github.com/testuser/nested-repo
	[ -d github.com/testuser/nested-repo/.git ]
}

## Drop patterns are workspace-relative, so a full path works from anywhere
testDropFullPathFromSubdirectory() {
	newWorkspace
	createRepo github.com/user/project

	cd github.com/user
	workset drop github.com/user/project

	[ ! -e project ]
	[ -d ../../.workset/github.com/user/project ]
}

## A drop pattern is resolved against the current directory first, so the
## './repo' form from the README works from the repo's parent
testDropRelativePathFromSubdirectory() {
	newWorkspace
	createRepo github.com/user/project

	cd github.com/user
	workset drop ./project

	[ ! -e project ]
	[ -d ../../.workset/github.com/user/project ]
}

## A bare repo name resolves against the current directory too
testDropBareNameFromSubdirectory() {
	newWorkspace
	createRepo github.com/user/project

	cd github.com/user
	workset drop project

	[ ! -e project ]
	[ -d ../../.workset/github.com/user/project ]
}

## A pattern that leaves the workspace names nothing workset manages, so the
## drop fails instead of consuming a repo the workspace never contained
testDropOutsideWorkspaceFails() {
	newWorkspace
	createRepo ../outside/repo

	for pattern in ../outside/repo "$(cd ../outside/repo && pwd)"; do
		output=$(workset drop "$pattern" 2>&1) && exit 1
		echo "$output" | grep "outside the workspace"

		output=$(workset drop --delete --force "$pattern" 2>&1) && exit 1
		echo "$output" | grep "outside the workspace"
	done

	# Worktree, git directory and all, exactly as it was
	[ -f ../outside/repo/file0.txt ]
	[ -d ../outside/repo/.git ]
	[ ! -e outside ]
	[ ! -e .workset/outside ]
}

## --delete says so instead of claiming the repo was dropped to the library
testDropWithDeleteReportsDeletion() {
	newWorkspace
	createRepo delete-me

	workset drop --delete delete-me | grep -- "delete-me - ✓ deleted"
}

## Restore matches library paths by substring, so a bare repo name is enough
testRestoreFromSubdirectory() {
	newWorkspace
	createRepo projects/my-project

	workset drop projects/my-project
	[ ! -e projects/my-project ]

	cd projects
	workset restore my-project
	[ -d my-project/.git ]
}

## Repeated drop/restore cycles keep the repo intact
testRepeatedDropRestoreCycles() {
	newWorkspace
	createRepo cycle-repo 1

	for i in 1 2 3; do
		workset drop cycle-repo
		[ ! -e cycle-repo ]

		workset restore cycle-repo
		[ -f cycle-repo/file0.txt ]
	done
}

## Every local branch comes back, not just the one HEAD pointed at, and the
## commits only reachable from them are still there
testDropRestorePreservesLocalBranches() {
	newWorkspace
	createRepo branchy 1

	git -C branchy checkout -q -b side
	echo side >branchy/side.txt
	git -C branchy add side.txt
	git -C branchy commit -q -m "only on side"
	side=$(git -C branchy rev-parse side)
	git -C branchy checkout -q main

	workset drop branchy
	workset restore branchy

	[ "$(git -C branchy rev-parse side)" = "$side" ]
	[ "$(git -C branchy branch --show-current)" = "main" ]
}

## Restoring moves the repo out of the library rather than leaving a stale
## duplicate behind for the next drop to overwrite
testRestoreEmptiesLibraryEntry() {
	newWorkspace
	createRepo moved 1

	workset drop moved
	[ -d .workset/moved ]

	workset restore moved
	[ ! -e .workset/moved ]
	workset status | grep "0 repository(ies) in library"
}

## Git config, including custom keys and remote URLs, survives a
## drop/restore round trip
testDropRestorePreservesConfig() {
	newWorkspace
	createRepo config-repo 1
	git -C config-repo remote add a https://example.com/a.git
	git -C config-repo remote add b https://example.com/b.git
	git -C config-repo config custom.key custom-value

	workset drop config-repo
	workset restore config-repo

	[ "$(git -C config-repo config custom.key)" = "custom-value" ]
	[ "$(git -C config-repo remote get-url a)" = "https://example.com/a.git" ]
	[ "$(git -C config-repo remote get-url b)" = "https://example.com/b.git" ]
	[ "$(git -C config-repo config core.bare)" = "false" ]
}

## A repo with submodule config survives a drop/restore round trip
testDropRepoWithGitmodules() {
	newWorkspace
	createRepo main-repo 2
	printf '[submodule "example"]\n\tpath = sub\n\turl = https://example.com/repo.git\n' >main-repo/.gitmodules
	git -C main-repo add .gitmodules
	git -C main-repo commit -q -m "Add submodule config"

	workset drop main-repo
	workset restore main-repo

	[ -f main-repo/.gitmodules ]
}

## Listing shows each repo with its status
testListShowsRepoStatus() {
	newWorkspace
	createRepo clean-repo 2
	createRepo dirty-repo 2
	echo "uncommitted" >dirty-repo/uncommitted.txt

	output=$(workset list)

	echo "$output" | grep "clean-repo - ✓ clean"
	echo "$output" | grep "dirty-repo - ⚠ modified"
}

## A repo whose HEAD is detached — mid-bisect, mid-rebase, or just checked
## out by commit — still has all its history, so it isn't "no commits"
testListDetachedHeadRepo() {
	newWorkspace
	createRepo detached-repo 2
	git -C detached-repo checkout -q --detach HEAD

	workset list | grep -- "detached-repo - ✓ clean"
	workset status | grep "✓ 1 clean"

	workset drop detached-repo | grep -- "detached-repo - ✓ dropped"
	workset restore detached-repo
	[ -f detached-repo/file1.txt ]
}

## Listing covers the whole workspace, not just the current directory
testListFromSubdirectory() {
	newWorkspace
	createRepo root-repo
	createRepo projects/sub-repo1
	createRepo projects/sub-repo2

	cd projects
	output=$(workset list)

	echo "$output" | grep "root-repo"
	echo "$output" | grep "projects/sub-repo1"
	echo "$output" | grep "projects/sub-repo2"
}

## Status summarizes the workspace and its library
testStatusSummary() {
	newWorkspace
	createRepo repo1
	createRepo repo2

	output=$(workset status)

	echo "$output" | grep "^Workspace: "
	echo "$output" | grep "^Library: "
	echo "$output" | grep "Active repositories: 2"
}

## Status is workspace-wide, regardless of the current directory
testStatusFromSubdirectory() {
	newWorkspace
	createRepo root-repo
	createRepo projects/sub-repo1
	createRepo projects/sub-repo2

	cd projects
	workset status | grep "Active repositories: 3"
}

## --help prints the usage text and works outside any workspace
testHelpFlag() {
	output=$(workset --help)

	echo "$output" | grep -E '^USAGE:'
	echo "$output" | grep -E '^  workset init'
}

## -h is a short alias for --help, not something that falls through to the TUI
testHelpShortFlag() {
	[ "$(workset -h)" = "$(workset --help)" ]
}

## --help reports usage from inside a workspace too, where a fall-through
## would have opened the TUI instead
testHelpFlagInWorkspace() {
	newWorkspace

	workset --help | grep -E '^USAGE:'
	workset -h | grep -E '^USAGE:'
}

## A flag nobody recognizes is reported instead of opening the TUI
testUnknownFlagFails() {
	newWorkspace

	output=$(workset --frobnicate 2>&1) && exit 1
	echo "$output" | grep "Unrecognized argument: --frobnicate"

	output=$(workset -x 2>&1) && exit 1
	echo "$output" | grep "Unrecognized argument: -x"
}

## --version prints the version and works outside any workspace
testVersionFlag() {
	workset --version | grep -E '^workset [0-9]+\.[0-9]+\.[0-9]+'
}

## -V is a short alias for --version
testVersionShortFlag() {
	workset -V | grep -E '^workset [0-9]+\.[0-9]+\.[0-9]+'
}

## --version reports the version from inside a workspace too
testVersionFlagInWorkspace() {
	newWorkspace
	workset --version | grep -E '^workset [0-9]+\.[0-9]+\.[0-9]+'
}
