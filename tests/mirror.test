#!/usr/bin/env bash

## Add a commit touching $2 to the repo at $1
addCommit() {
	echo "$2" >"$1/$2"
	git -C "$1" add "$2"
	git -C "$1" commit -q -m "$2"
}

## Initialize a workspace holding `repo` on branch main, with two bare remotes
## `a` and `b` both seeded with its initial commit, and mirroring enabled;
## `a` is the upstream of main. The bare remotes live outside the workspace so
## workset doesn't treat them as repos of their own.
setupMirror() {
	mkdir remotes
	remotes=$PWD/remotes
	git init -q --bare "$remotes/a.git"
	git init -q --bare "$remotes/b.git"

	mkdir ws
	cd ws
	workset init

	mkdir repo
	git -C repo init -q -b main
	git -C repo config user.email test@example.com
	git -C repo config user.name "Test User"
	addCommit repo initial.txt

	git -C repo remote add a "$remotes/a.git"
	git -C repo remote add b "$remotes/b.git"
	workset mirror init
	git -C repo push -q -u a main
	git -C repo push -q b main
}

## mirror init stores the default branch and all-tags patterns
testMirrorInitSetsDefaultPatterns() {
	setupMirror

	[ "$(git -C repo config --get-all workset.mirrorBranches)" = "main" ]
	[ "$(git -C repo config --get-all workset.mirrorTags)" = "*" ]
}

## mirror init with a pattern only enables matching repos
testMirrorInitPatternScopesToMatch() {
	setupMirror
	mkdir other
	git -C other init -q -b main

	workset mirror init repo

	[ "$(git -C repo config --get-all workset.mirrorBranches)" = "main" ]
	! git -C other config --get workset.mirrorBranches
	! git -C other config --get workset.mirrorTags
}

## Running mirror init twice reports the repo as already enabled
testMirrorInitIsIdempotent() {
	setupMirror

	output=$(workset mirror init)

	echo "$output" | grep "repo - already enabled"
	[ "$(git -C repo config --get-all workset.mirrorBranches)" = "main" ]
	[ "$(git -C repo config --get-all workset.mirrorTags)" = "*" ]
}

## --branches/--tags flags are stored verbatim, repeated flags add values
testMirrorInitFlagsStoreMultipleValues() {
	setupMirror

	workset mirror init --branches main --branches 'release/*' --tags 'v?' repo

	[ "$(git -C repo config --get-all workset.mirrorBranches)" = "$(printf 'main\nrelease/*')" ]
	[ "$(git -C repo config --get-all workset.mirrorTags)" = "v?" ]
}

## The legacy boolean workset.mirror flag is ignored; repos holding only it
## read as mirroring-disabled
testMirrorIgnoresLegacyBoolFlag() {
	setupMirror
	git -C repo config --unset-all workset.mirrorBranches
	git -C repo config --unset-all workset.mirrorTags
	git -C repo config workset.mirror true
	seeded=$(git -C "$remotes/b.git" rev-parse main)
	addCommit repo new.txt
	git -C repo push -q a main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - skipped (mirroring disabled)"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$seeded" ]
}

## mirror without a subcommand prints usage
testMirrorWithoutSubcommandShowsUsage() {
	setupMirror

	workset mirror 2>&1 | grep "Usage: workset mirror"
}

## A commit the user pushed to one remote is mirrored to the others
testMirrorMirrorsPushedCommit() {
	setupMirror
	addCommit repo new.txt
	git -C repo push -q a main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ pushed main to b"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$(git -C repo rev-parse HEAD)" ]
	workset list | grep "repo - ✓ clean"
}

## --dryrun reports what would be pushed without pushing anything
testMirrorDryrunReportsWithoutPushing() {
	setupMirror
	seeded=$(git -C "$remotes/b.git" rev-parse main)
	addCommit repo new.txt
	git -C repo push -q a main

	output=$(workset mirror sync --dryrun)

	echo "$output" | grep "repo - would push main to b"
	! echo "$output" | grep "✓ pushed"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$seeded" ]

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ pushed main to b"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$(git -C repo rev-parse HEAD)" ]
}

## Commits that exist only locally are never pushed
testMirrorNeverPushesUnpushedCommits() {
	setupMirror
	seeded=$(git -C repo rev-parse HEAD)
	addCommit repo local-only.txt

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ in sync"
	[ "$(git -C "$remotes/a.git" rev-parse main)" = "$seeded" ]
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$seeded" ]
	workset list | grep "repo - ⚠ unpushed"
}

## A commit pushed to one remote from another machine propagates to the other
## remotes, without a manual fetch and without touching the local checkout
testMirrorPropagatesPushFromAnotherMachine() {
	setupMirror
	local_head=$(git -C repo rev-parse HEAD)

	git clone -q -b main "$remotes/a.git" ../elsewhere
	git -C ../elsewhere config user.email test@example.com
	git -C ../elsewhere config user.name "Test User"
	addCommit ../elsewhere elsewhere.txt
	git -C ../elsewhere push -q origin main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ pushed main to b"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$(git -C ../elsewhere rev-parse HEAD)" ]
	[ "$(git -C repo rev-parse HEAD)" = "$local_head" ]
}

## A tag pushed from another machine is mirrored, even when its commit isn't
## in any local branch, without creating a local tag
testMirrorPropagatesRemoteOnlyTag() {
	setupMirror
	git clone -q "$remotes/a.git" ../elsewhere
	git -C ../elsewhere config user.email test@example.com
	git -C ../elsewhere config user.name "Test User"
	addCommit ../elsewhere tagged.txt
	git -C ../elsewhere tag v9
	git -C ../elsewhere push -q origin refs/tags/v9

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ pushed v9 to b"
	[ "$(git -C "$remotes/b.git" rev-parse refs/tags/v9)" = "$(git -C ../elsewhere rev-parse refs/tags/v9)" ]
	! git -C repo rev-parse -q --verify refs/tags/v9
}

## A diverged remote is reported rather than force-pushed
testMirrorReportsDivergenceWithoutForcing() {
	setupMirror
	# Push one commit to b, then abandon it and push a different one to a,
	# leaving b diverged from the published history
	addCommit repo abandoned.txt
	git -C repo push -q b main
	abandoned=$(git -C repo rev-parse HEAD)
	git -C repo reset -q --hard HEAD~1
	addCommit repo kept.txt
	git -C repo push -q a main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ⚠ main on b:"
	! echo "$output" | grep "pushed main to b"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$abandoned" ]
}

## A branch that was never pushed anywhere is left alone
testMirrorLeavesLocalOnlyBranchAlone() {
	setupMirror
	git -C repo checkout -q -b feature
	addCommit repo feature.txt
	git -C repo checkout -q main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ in sync"
	! git -C "$remotes/a.git" rev-parse --verify refs/heads/feature
	! git -C "$remotes/b.git" rev-parse --verify refs/heads/feature
}

## Tags are mirrored, and a tag pointing somewhere else is a conflict
testMirrorMirrorsTagsAndReportsMismatch() {
	setupMirror
	git -C repo tag v1
	git -C repo push -q a refs/tags/v1

	# b holds a v2 tag pointing at a different commit than the local v2
	old_head=$(git -C repo rev-parse HEAD)
	addCommit repo v2.txt
	git -C repo push -q a main
	git -C repo tag v2
	git -C repo push -q a refs/tags/v2
	git -C "$remotes/b.git" update-ref refs/tags/v2 "$old_head"

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ⚠ v2 on b:"
	[ "$(git -C "$remotes/b.git" rev-parse refs/tags/v1)" = "$(git -C repo rev-parse refs/tags/v1)" ]
	[ "$(git -C "$remotes/b.git" rev-parse refs/tags/v2)" = "$old_head" ]
}

## Mirroring refreshes tracking refs, clearing a stale unpushed status
testMirrorRefreshesStaleUnpushedStatus() {
	setupMirror
	addCommit repo new.txt
	git -C repo push -q a main
	git -C repo push -q b main

	# Simulate a stale tracking ref, as if the push happened elsewhere
	git -C repo update-ref refs/remotes/a/main HEAD~1
	workset list | grep "repo - ⚠ unpushed"

	workset mirror sync

	workset list | grep "repo - ✓ clean"
}

## An unreachable remote doesn't stop the reachable ones from being mirrored
testMirrorContinuesPastUnreachableRemote() {
	setupMirror
	git init -q --bare "$remotes/c.git"
	git -C repo remote add c "$remotes/c.git"
	git -C repo push -q c main
	rm -rf "$remotes/c.git"

	addCommit repo new.txt
	git -C repo push -q a main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✗ fetch c failed"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$(git -C repo rev-parse HEAD)" ]
}

## When no remote is reachable the repo is not reported as in sync
testMirrorReportsUnreachableInsteadOfInSync() {
	setupMirror
	rm -rf "$remotes/a.git" "$remotes/b.git"

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ⚠ remotes unreachable"
	! echo "$output" | grep "in sync"
}

## A repo with mirroring disabled is skipped entirely
testMirrorSkipsRepoWithoutMirrorConfig() {
	setupMirror
	git -C repo config --unset-all workset.mirrorBranches
	git -C repo config --unset-all workset.mirrorTags
	seeded=$(git -C "$remotes/b.git" rev-parse main)
	addCommit repo new.txt
	git -C repo push -q a main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - skipped (mirroring disabled)"
	! echo "$output" | grep "pushed"
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$seeded" ]
}

## A published branch not matching the branch pattern is not mirrored
testMirrorBranchPatternExcludesBranch() {
	setupMirror
	git -C repo checkout -q -b feature
	addCommit repo feature.txt
	git -C repo push -q a feature
	git -C repo checkout -q main

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ in sync"
	! git -C "$remotes/b.git" rev-parse --verify refs/heads/feature
}

## Only tags matching the tag pattern are mirrored
testMirrorTagPatternFilters() {
	setupMirror
	git -C repo config --replace-all workset.mirrorTags 'v*'
	git -C repo tag v1
	git -C repo tag x1
	git -C repo push -q a refs/tags/v1 refs/tags/x1

	output=$(workset mirror sync)

	echo "$output" | grep "repo - ✓ pushed v1 to b"
	[ "$(git -C "$remotes/b.git" rev-parse refs/tags/v1)" = "$(git -C repo rev-parse refs/tags/v1)" ]
	! git -C "$remotes/b.git" rev-parse --verify refs/tags/x1
}

## A tags-only config still counts as enabled and mirrors tags but no branches
testMirrorOnlyTagsIsEnabled() {
	setupMirror
	git -C repo config --unset-all workset.mirrorBranches
	seeded=$(git -C "$remotes/b.git" rev-parse main)
	addCommit repo new.txt
	git -C repo tag v1
	git -C repo push -q a main refs/tags/v1

	output=$(workset mirror sync)

	! echo "$output" | grep "skipped"
	echo "$output" | grep "repo - ✓ pushed v1 to b"
	[ "$(git -C "$remotes/b.git" rev-parse refs/tags/v1)" = "$(git -C repo rev-parse refs/tags/v1)" ]
	[ "$(git -C "$remotes/b.git" rev-parse main)" = "$seeded" ]
}
